# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
.env
server/*.db
server/*.db-wal
server/*.db-shm
# Hand-made DB copies. `server/*.db` does NOT match these — the convention
# already in use on production is `data.db.backup-20260815-144554`, where the
# name ends in the timestamp, not in `.db`. One of these in the working tree
# would be silently committable, and it holds every password hash, Pterodactyl
# client key and session secret the live DB does.
server/*.db.backup-*
server/*.db.bak
server/data.db.*
pterodactyl/data

# Real credentials that live in the working tree, not just .env:
# WireGuard keypair for the relay tunnel, and the live Wings daemon's own
# auth token (embedded inline in its config, not in a separate env file).
node1_private.key
node1_public.key
pterodactyl/wings/etc/config.yml

